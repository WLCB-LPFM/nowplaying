# Copy this file to /home/nowplaying/.env and fill in the values.
# Owned by nowplaying:nowplaying, mode 600.

PLAYIT_BASE_URL=https://10.101.0.101:25433
PLAYIT_API_KEY=
PLAYIT_VERIFY_TLS=0
AUTOPOST_URL=https://widgets.autopo.st/fingerprinting/public/WLCB/nowplaying.json
REPO_DIR=/home/nowplaying/nowplaying
SCHEDULE_PATH=/home/nowplaying/nowplaying/schedule.json
POLL_INTERVAL_S=20

# Icecast stream title (same text as RDS now.txt). Leave ICECAST_URL or ICECAST_PASSWORD empty to turn it off.
# Password: the station's Icecast admin password (panel.justhostwith.us -> WLCB -> Admin login -> Reveal).
ICECAST_URL=https://seahorse.juststreamwith.us:8006
ICECAST_MOUNTS=/stream
ICECAST_USER=admin
ICECAST_PASSWORD=
ICECAST_REFRESH_S=300
